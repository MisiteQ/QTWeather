#!/bin/bash
# 安装后立即启动服务，确保桌面网关能找到 app.sock。
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST:-$(dirname -- "${SCRIPT_DIR}")}"
PKGVAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"
TEMP_LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/com.qweather.widget.log}"
if [ -x "${APP_DIR}/cmd/main" ]; then
	"${APP_DIR}/cmd/main" start
	if [ $? -eq 0 ]; then
		echo "安装完成，时钟天气 QTWeather 服务已启动。" > "${TEMP_LOG_FILE}"
		exit 0
	fi
fi

echo "安装完成，但时钟天气 QTWeather 服务启动失败，请查看 ${PKGVAR_DIR}/app.log。" > "${TEMP_LOG_FILE}"
exit 0
