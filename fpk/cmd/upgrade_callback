#!/bin/bash
# 升级后启动服务。依赖统一由 cmd/main 管理（v3.0.5 起安装在持久化数据目录，
# 已安装则直接跳过），这里不再重复 pip install，缩短升级空窗期。
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST:-$(dirname -- "${SCRIPT_DIR}")}"

# 后台启动并立即返回：应用中心的升级请求有前端超时限制，
# 若在这里同步等待依赖安装/健康检查，就会弹
# “Request failed, please try again later”（后台任务其实还在继续）。
if [ -x "${APP_DIR}/cmd/main" ]; then
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup "${APP_DIR}/cmd/main" start >/dev/null 2>&1 &
    else
        nohup "${APP_DIR}/cmd/main" start >/dev/null 2>&1 &
    fi
fi

exit 0
