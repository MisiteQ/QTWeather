#!/bin/bash
# 时钟天气 QTWeather 小部件 - 启停管理脚本

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST:-$(dirname -- "${SCRIPT_DIR}")}"
PKGVAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"
TEMP_LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/com.qweather.widget.log}"
PID_FILE="${PKGVAR_DIR}/app.pid"
LOG_FILE="${PKGVAR_DIR}/app.log"
LIBS_DIR="${APP_DIR}/libs"
# gunicorn 双绑定（参照 fn-seekbox / fnytdlp 等网关应用）：
#   - unix socket 放在 target 目录（/var/apps/<app>/target -> @appcenter/<app>）
#     下，trim_sac 扫描各应用 target 目录的 *.sock，填充 gateway_socket 并向
#     trim_http_cgi 注册网关转发 /app/com.qweather.widget/* —— 桌面图标窗口
#     经同源 HTTPS 网关打开（局域网 IP / 域名 / http / https 全部可用）；
#   - 同时保留 127.0.0.1:5698 TCP 绑定，供本机 nginx 反代
#     /qweather-api/settings、/qweather-api/font 使用。
SOCKET_FILE="${APP_DIR}/app.sock"
SERVICE_PORT="${TRIM_SERVICE_PORT:-5698}"

# 确保依赖已安装（libs 目录存在且包含 gunicorn）
ensure_deps() {
    # 检查 gunicorn 是否可用（通过 PYTHONPATH）
    if PYTHONPATH="${LIBS_DIR}" python3 -c "import gunicorn" 2>/dev/null; then
        return 0
    fi

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 依赖未就绪，正在安装..." >> "${LOG_FILE}"

    # 确保 libs 目录存在
    mkdir -p "${LIBS_DIR}"

    # 检查 pip 是否可用
    if ! python3 -m pip --version > /dev/null 2>&1; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] pip 不可用，尝试安装..." >> "${LOG_FILE}"
        curl -sS https://bootstrap.pypa.io/get-pip.py | python3 - --user >> "${LOG_FILE}" 2>&1
        if [ $? -ne 0 ]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: pip 安装失败，请检查网络" >> "${LOG_FILE}"
            return 1
        fi
    fi

    # 安装依赖到 libs 目录
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 正在安装 Flask、requests、gunicorn..." >> "${LOG_FILE}"
    python3 -m pip install \
        --target "${LIBS_DIR}" \
        --no-cache-dir \
        --upgrade \
        -r "${APP_DIR}/requirements.txt" >> "${LOG_FILE}" 2>&1

    # 默认源失败时用清华镜像重试一次
    if [ $? -ne 0 ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] 默认源失败，尝试清华镜像..." >> "${LOG_FILE}"
        python3 -m pip install \
            --target "${LIBS_DIR}" \
            --no-cache-dir \
            --upgrade \
            -i https://pypi.tuna.tsinghua.edu.cn/simple \
            -r "${APP_DIR}/requirements.txt" >> "${LOG_FILE}" 2>&1
    fi

    if [ $? -ne 0 ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: 依赖安装失败，请检查网络连接" >> "${LOG_FILE}"
        return 1
    fi

    # 验证安装
    if ! PYTHONPATH="${LIBS_DIR}" python3 -c "import gunicorn, flask, requests" 2>/dev/null; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: 依赖验证失败" >> "${LOG_FILE}"
        return 1
    fi

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 依赖安装完成" >> "${LOG_FILE}"
    return 0
}

case "$1" in
    start)
        # 彻底清理所有旧 gunicorn 进程（防止端口冲突导致启动失败）
        pkill -f "gunicorn.*${SOCKET_FILE}" 2>/dev/null
        pkill -f "gunicorn.*127.0.0.1:${SERVICE_PORT}" 2>/dev/null
        sleep 1

        # 检查是否已在运行
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" | tr -d '[:space:]')
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                exit 0
            fi
            rm -f "$PID_FILE"
        fi

        # 确保运行时目录存在
        mkdir -p "${PKGVAR_DIR}"
        mkdir -p /var/run

        # 应用安装目录必须可被网关进程穿越（socket 放在该目录下）
        chmod 755 "${APP_DIR}" 2>/dev/null

        # 清理旧的 socket 文件
        rm -f "${SOCKET_FILE}"

        # 确保依赖已安装
        if ! ensure_deps; then
            echo "依赖安装失败，请查看日志: ${LOG_FILE}" > "${TEMP_LOG_FILE}"
            exit 1
        fi

        # 启动 gunicorn，同时绑定：
        #   1) unix socket（app.sock）——trim_sac 扫描 target 目录后向
        #      trim_http_cgi 注册网关转发，点桌面图标时同源 iframe 走
        #      https://<host>/app/com.qweather.widget/，HTTP/HTTPS、
        #      局域网/域名访问均可打开，且不受混合内容与外网端口限制；
        #   2) 127.0.0.1:${SERVICE_PORT}——供本机 nginx 反代
        #      /qweather-api/settings、/qweather-api/font 使用。
        # --umask 0 让 socket 文件对网关进程可连接（需要写权限）。
        cd "${APP_DIR}"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] 启动 gunicorn，unix:${SOCKET_FILE} + 127.0.0.1:${SERVICE_PORT}" >> "${LOG_FILE}"

        PYTHONPATH="${LIBS_DIR}" nohup python3 -m gunicorn \
            --bind "unix:${SOCKET_FILE}" \
            --bind "127.0.0.1:${SERVICE_PORT}" \
            --umask 0 \
            --workers 1 \
            --threads 4 \
            --timeout 30 \
            --access-logfile "${LOG_FILE}" \
            --error-logfile "${LOG_FILE}" \
            app:app \
            >> "${LOG_FILE}" 2>&1 &

        echo $! > "${PID_FILE}"

        # 等待服务就绪（最多20秒，依赖安装可能需要时间）：
        # TCP 健康检查通过后再显式放开 socket 权限（双保险）。
        for i in $(seq 1 20); do
            if curl -sf "http://127.0.0.1:${SERVICE_PORT}/health" > /dev/null 2>&1; then
                chmod 777 "${SOCKET_FILE}" 2>/dev/null
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] 服务启动成功（socket 与端口均就绪）" >> "${LOG_FILE}"
                exit 0
            fi
            sleep 1
        done

        # 检查进程是否还在
        pid=$(cat "$PID_FILE" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] 进程运行中但端口未就绪，继续等待" >> "${LOG_FILE}"
            exit 0
        fi

        echo "应用启动失败，请查看日志: ${LOG_FILE}" > "${TEMP_LOG_FILE}"
        rm -f "${PID_FILE}"
        exit 1
        ;;

    stop)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" | tr -d '[:space:]')
            if [ -n "$pid" ]; then
                # 优雅停止主进程，gunicorn 会自动清理 worker
                kill "$pid" 2>/dev/null
                # 等待进程退出（最多10秒）
                for i in $(seq 1 10); do
                    if ! kill -0 "$pid" 2>/dev/null; then
                        break
                    fi
                    sleep 1
                done
                # 强制清理残留
                kill -9 "$pid" 2>/dev/null
            fi
            rm -f "$PID_FILE"
        fi

        # 额外清理本应用可能残留的 gunicorn 进程
        pkill -f "gunicorn.*127.0.0.1:${SERVICE_PORT}" 2>/dev/null

        # 清理 socket 文件
        rm -f "${SOCKET_FILE}"

        exit 0
        ;;

    status)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" | tr -d '[:space:]')
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                exit 0
            fi
            rm -f "$PID_FILE"
        fi
        exit 3
        ;;

    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
