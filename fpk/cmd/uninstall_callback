#!/bin/bash
# 卸载后：清理本应用所有残留——进程、依赖、nginx 注入配置、加密 zip 条目、注入页
# 必须兜底清理 nginx：uninstall_init 可能因应用已停止（socket 不存在）
# 无法调用 /api/uninstall，导致 conf.d/qweather.conf 和 ng.conf.zip 条目
# 残留为孤儿配置，永久占用 location = / 使桌面路由失效。

# 1. 清理进程（精确匹配本应用 socket 路径，不误杀其他 gunicorn）
pkill -f "gunicorn.*com.qweather.widget/app.sock" 2>/dev/null

# 2. 清理依赖目录
rm -rf "${TRIM_APPDEST}/libs" 2>/dev/null

# 3. 清理 nginx conf.d 中的 qweather.conf
QW_NGINX_CONF="/usr/trim/nginx/conf/conf.d/qweather.conf"
rm -f "${QW_NGINX_CONF}" 2>/dev/null

# 4. 从加密 ng.conf.zip 中删除 conf.d/qweather.conf 条目
#    用 raw bytes 操作保留其他条目的加密/压缩，不破坏系统恢复包
NG_CONF_ZIP="/usr/trim/share/.restore/ng.conf.zip"
QW_ARCNAME="conf.d/qweather.conf"
if [ -f "${NG_CONF_ZIP}" ]; then
    python3 - <<'PYEOF'
import struct, os, zipfile, sys

zip_path = "/usr/trim/share/.restore/ng.conf.zip"
arcname = "conf.d/qweather.conf"

def _dos_time(dt):
    y, m, d, hh, mm, ss = dt
    return ((hh << 11) | (mm << 5) | (ss // 2),
            ((max(y, 1980) - 1980) << 9) | (m << 5) | d)

def _local_header(ver, flags, method, dtime, ddate, crc, csize, usize, name, extra):
    return (b"PK\x03\x04" + struct.pack(
        "<HHHHHIIIHH", ver, flags, method, dtime, ddate,
        crc, csize, usize, len(name), len(extra)) + name + extra)

def _central_record(ver, flags, method, dtime, ddate, crc, csize, usize,
                    name, extra, offset, internal=0, external=0):
    return (b"PK\x01\x02" + struct.pack(
        "<HHHHHHIIIHHHHHII", 0x0314, ver, flags, method, dtime, ddate,
        crc, csize, usize, len(name), len(extra), 0, 0,
        internal, external, offset) + name + extra)

def _read_raw_entries(zp):
    entries = []
    with zipfile.ZipFile(zp) as src:
        infos = src.infolist()
    with open(zp, "rb") as fh:
        for info in infos:
            fh.seek(info.header_offset)
            sig = fh.read(4)
            if sig != b"PK\x03\x04":
                continue
            hdr_rest = fh.read(26)
            nlen, xlen = struct.unpack("<HH", hdr_rest[22:26])
            ne = fh.read(nlen + xlen)
            data_raw = fh.read(info.compress_size)
            desc = b""
            if info.flag_bits & 0x0008:
                d = fh.read(16)
                if d[:4] == b"PK\x07\x08":
                    desc = d
            entries.append((info, ne[:nlen], ne[nlen:], data_raw, desc))
    return entries

try:
    with zipfile.ZipFile(zip_path) as z:
        if arcname not in z.namelist():
            sys.exit(0)
    entries = [e for e in _read_raw_entries(zip_path)
               if e[0].filename != arcname]
    tmp = zip_path + ".qwtmp"
    with open(tmp, "wb") as out:
        offsets = []
        for info, name, extra, data, desc in entries:
            offsets.append(out.tell())
            dt = _dos_time(info.date_time) if info.date_time[0] else (0, 0)
            out.write(_local_header(
                info.extract_version, info.flag_bits,
                info.compress_type, dt[0], dt[1], info.CRC,
                info.compress_size, info.file_size, name, extra))
            out.write(data)
            if desc:
                out.write(desc)
        cd = bytearray()
        for (info, name, extra, _, _d), off in zip(entries, offsets):
            dt = _dos_time(info.date_time) if info.date_time[0] else (0, 0)
            cd += _central_record(
                info.extract_version, info.flag_bits,
                info.compress_type, dt[0], dt[1], info.CRC,
                info.compress_size, info.file_size, name, extra, off,
                internal=info.internal_attr,
                external=info.external_attr)
        cd_start = out.tell()
        out.write(cd)
        cd_size = out.tell() - cd_start
        total = len(entries)
        out.write(b"PK\x05\x06" + struct.pack(
            "<HHHHIIH", 0, 0, total, total, cd_size, cd_start, 0))
    os.replace(tmp, zip_path)
except Exception:
    pass
PYEOF
fi

# 5. 清理注入页目录
rm -rf "/vol1/@appdata/${TRIM_APPNAME}/desktop" 2>/dev/null

# 6. 重启 nginx 恢复桌面路由（去掉孤儿 location 块）
systemctl restart trim_nginx 2>/dev/null
sleep 3

exit 0
